{
  "name": "is-there-electricity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:collector": "pnpm --filter @app/collector dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @app/web preview",
    "start": "pnpm -r --parallel start",
    "start:web": "pnpm --filter @app/web start",
    "start:collector": "pnpm --filter @app/collector start",
    "pm2:start": "pnpm build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop collector",
    "pm2:restart": "pm2 restart collector",
    "pm2:status": "pm2 ls",
    "pm2:logs": "pm2 logs collector",
    "pm2:save": "pm2 save",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @app/db run migrate",
    "db:reset": "pnpm --filter @app/db run reset"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pm2": "^5.4.3",
    "typescript": "^5.8.3"
  }
}