    "reset": "node dist/reset.js"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}