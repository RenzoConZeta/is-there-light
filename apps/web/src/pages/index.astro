---
import { listChargeEvents } from "../lib/events.js";

export const prerender = false;

const events = await listChargeEvents({ limit: 200 });

function labelFor(type: string): string {
  return type === "plug" ? "Conectado" : "Desconectado";
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Historial de energía</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f1115" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Electricidad" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon-180.png" />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #0f1115;
        --panel: #171a21;
        --border: #262b36;
        --text: #e6e8ee;
        --muted: #9aa3b2;
        --plug: #2f9e44;
        --unplug: #e03131;
      }

      * {
        box-sizing: border-box;
      }

      /* El atributo `hidden` debe ganar siempre a los `display` de autor. */
      [hidden] {
        display: none !important;
      }

      body {
        margin: 0;
        padding: 2rem 1rem;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      main {
        max-width: 720px;
        margin: 0 auto;
      }

      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.25rem;
      }

      .subtitle {
        margin: 0 0 1.5rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .empty {
        padding: 2rem;
        text-align: center;
        border: 1px dashed var(--border);
        border-radius: 12px;
        color: var(--muted);
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
      }

      .badge {
        flex: 0 0 auto;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        color: #fff;
      }

      .badge.plug {
        background: var(--plug);
      }

      .badge.unplug {
        background: var(--unplug);
      }

      .occurred {
        font-variant-numeric: tabular-nums;
      }

      .source {
        margin-left: auto;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .push-controls {
        margin: 1rem 0 1.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--panel);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .push-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .push-status {
        color: var(--muted);
        font-size: 0.9rem;
      }

      button {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text);
        cursor: pointer;
        transition: background 0.2s;
      }

      button:hover {
        background: rgba(255,255,255,0.05);
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .button-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      input[type="date"] {
        padding: 0.45rem 0.6rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 0.9rem;
      }

      .event-check {
        flex: 0 0 auto;
        width: 1.1rem;
        height: 1.1rem;
        accent-color: var(--plug);
        cursor: pointer;
      }

      button.danger {
        border-color: rgba(224, 49, 49, 0.5);
        color: #ff8787;
      }

      button.danger:hover:not(:disabled) {
        background: rgba(224, 49, 49, 0.15);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Historial de energía</h1>
      <p class="subtitle">Cambios de estado de carga registrados por el collector.</p>

      <section class="push-controls" id="push-controls" hidden>
        <div class="push-row">
          <span class="push-status" id="push-status">Notificaciones push</span>
          <button id="push-toggle">Activar</button>
        </div>
        <small class="push-status">Recibe avisos al conectarse/desconectarse.</small>
      </section>

      <section class="push-controls" id="install-controls" hidden>
        <div class="push-row">
          <span class="push-status">Instalar la app</span>
          <button id="install-button">Instalar</button>
        </div>
        <small class="push-status">Añádela a tu dispositivo para uso sin conexión y notificaciones.</small>
      </section>

      <section class="push-controls" id="delete-controls" hidden={events.length === 0}>
        <div class="push-row">
          <span class="push-status" id="selection-status">0 eventos seleccionados</span>
          <div class="button-group">
            <button id="select-all">Todos</button>
            <button id="select-none">Ninguno</button>
            <button id="delete-selected" class="danger" disabled>Eliminar seleccionados</button>
          </div>
        </div>
        <div class="push-row">
          <label class="push-status" for="before-date">Eliminar anteriores al</label>
          <div class="button-group">
            <input type="date" id="before-date" />
            <button id="delete-before" class="danger">Eliminar anteriores</button>
          </div>
        </div>
        <small class="push-status">Las eliminaciones no se pueden deshacer.</small>
      </section>

      <p class="empty" id="empty-state" hidden={events.length > 0}>Todavía no hay eventos registrados.</p>

      <ul id="event-list" hidden={events.length === 0}>
        {events.map((event) => (
          <li data-event-id={event.id}>
            <input
              type="checkbox"
              class="event-check"
              value={event.id}
              aria-label={`Seleccionar el evento del ${event.occurred_at}`}
            />
            <span class={`badge ${event.type}`}>{labelFor(event.type)}</span>
            <time class="occurred" datetime={event.occurred_at}>{event.occurred_at}</time>
            <span class="source">{event.source}</span>
          </li>
        ))}
      </ul>
    </main>

    <script>
      (function () {
        // El service worker (caché + push) solo se usa en producción: en `astro dev`
        // interferiría con el HMR y el servidor de módulos de Vite.
        const IS_PROD = import.meta.env.PROD;

        // Formatea las fechas en la zona horaria del navegador. El servidor renderiza
        // el ISO en UTC como fallback (para el caso de no-JS); aquí se reemplaza por
        // la hora local del visitante.
        function formatTimes() {
          const formatter = new Intl.DateTimeFormat('es-ES', {
            dateStyle: 'medium',
            timeStyle: 'medium',
          });

          document.querySelectorAll('time[datetime]').forEach((el) => {
            const date = new Date(el.getAttribute('datetime'));
            if (Number.isNaN(date.getTime())) return;
            el.textContent = formatter.format(date);
          });
        }

        formatTimes();

        const controls = document.getElementById('push-controls');
        const statusEl = document.getElementById('push-status');
        const toggle = document.getElementById('push-toggle');
        const installControls = document.getElementById('install-controls');
        const installButton = document.getElementById('install-button');

        let isSubscribed = false;
        let registration = null;
        let deferredPrompt = null;

        function urlBase64ToUint8Array(base64String) {
          const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
          const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
          const rawData = atob(base64);
          const outputArray = new Uint8Array(rawData.length);
          for (let i = 0; i < rawData.length; ++i) {
            outputArray[i] = rawData.charCodeAt(i);
          }
          return outputArray;
        }

        function setupInstall() {
          if (!installControls || !installButton) return;

          window.addEventListener('beforeinstallprompt', (event) => {
            event.preventDefault();
            deferredPrompt = event;
            installControls.hidden = false;
          });

          window.addEventListener('appinstalled', () => {
            deferredPrompt = null;
            installControls.hidden = true;
          });

          installButton.addEventListener('click', async () => {
            if (!deferredPrompt) return;
            installButton.disabled = true;
            try {
              deferredPrompt.prompt();
              await deferredPrompt.userChoice;
            } catch (e) {
              console.warn('Install prompt failed', e);
            } finally {
              deferredPrompt = null;
              installControls.hidden = true;
              installButton.disabled = false;
            }
          });
        }

        async function registerServiceWorker() {
          try {
            registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
            await navigator.serviceWorker.ready;
          } catch (e) {
            console.warn('SW registration failed', e);
            return false;
          }
          return true;
        }

        function watchForUpdates() {
          // Si una versión nueva del SW toma el control, recarga una vez.
          if (!navigator.serviceWorker.controller) return;
          let reloading = false;
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (reloading) return;
            reloading = true;
            location.reload();
          });
        }

        async function init() {
          if (!IS_PROD) {
            console.info('[pwa] Service worker deshabilitado en desarrollo');
            return;
          }

          if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
            return;
          }

          if (!controls || !statusEl || !toggle) {
            return;
          }

          const registered = await registerServiceWorker();
          if (!registered) return;

          watchForUpdates();

          try {
            const sub = await registration.pushManager.getSubscription();
            isSubscribed = !!sub;
          } catch (e) {
            isSubscribed = false;
          }

          controls.hidden = false;
          updateUI();

          toggle.addEventListener('click', onToggle);
        }

        function updateUI() {
          if (isSubscribed) {
            statusEl.textContent = 'Notificaciones activadas';
            toggle.textContent = 'Desactivar';
          } else {
            statusEl.textContent = 'Notificaciones desactivadas';
            toggle.textContent = 'Activar';
          }
        }

        async function getPublicKey() {
          const res = await fetch('/api/vapid-public-key');
          if (!res.ok) throw new Error('No se pudo obtener VAPID key');
          const data = await res.json();
          return data.publicKey;
        }

        async function subscribe() {
          try {
            const publicKey = await getPublicKey();
            const sub = await registration.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: urlBase64ToUint8Array(publicKey),
            });
            await fetch('/api/push/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(sub),
            });
            isSubscribed = true;
          } catch (e) {
            console.error('Subscription failed', e);
          }
        }

        async function unsubscribe() {
          try {
            const sub = await registration?.pushManager.getSubscription();
            if (sub) {
              await sub.unsubscribe();
              await fetch('/api/push/unsubscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ endpoint: sub.endpoint }),
              });
            }
            isSubscribed = false;
          } catch (e) {
            console.error('Unsubscribe failed', e);
          }
        }

        async function onToggle() {
          toggle.disabled = true;
          try {
            if (isSubscribed) {
              await unsubscribe();
            } else {
              await subscribe();
            }
          } finally {
            updateUI();
            toggle.disabled = false;
          }
        }

        // Capturamos el evento de instalación lo antes posible (puede dispararse
        // antes de `load`), aunque el SW se registre más tarde.
        setupInstall();

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', init);
        } else {
          init();
        }
      })();

      // --- Borrado de registros -------------------------------------------------
      (function () {
        const list = document.getElementById('event-list');
        const emptyState = document.getElementById('empty-state');
        const controls = document.getElementById('delete-controls');
        const status = document.getElementById('selection-status');
        const selectAll = document.getElementById('select-all');
        const selectNone = document.getElementById('select-none');
        const deleteSelected = document.getElementById('delete-selected');
        const beforeDate = document.getElementById('before-date');
        const deleteBefore = document.getElementById('delete-before');

        if (!list || !deleteSelected || !deleteBefore || !beforeDate) return;

        function checks() {
          return Array.from(list.querySelectorAll('.event-check'));
        }

        function selectedIds() {
          return checks()
            .filter((check) => check.checked)
            .map((check) => Number(check.value));
        }

        function updateSelection() {
          const count = selectedIds().length;

          if (status) {
            status.textContent = count === 1 ? '1 evento seleccionado' : `${count} eventos seleccionados`;
          }

          deleteSelected.disabled = count === 0;
          deleteSelected.textContent =
            count > 0 ? `Eliminar seleccionados (${count})` : 'Eliminar seleccionados';
          deleteBefore.disabled = beforeDate.value === '';
        }

        function setBusy(busy) {
          [selectAll, selectNone, deleteSelected, deleteBefore].forEach((button) => {
            if (button) button.disabled = busy;
          });
        }

        async function sendDelete(payload) {
          const res = await fetch('/api/events', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            throw new Error(data.error || 'No se pudieron borrar los eventos');
          }

          return data;
        }

        async function onDeleteSelected() {
          const ids = selectedIds();

          if (ids.length === 0) return;

          const ok = window.confirm(
            `¿Eliminar ${ids.length} evento(s) del historial? Esta acción no se puede deshacer.`
          );
          if (!ok) return;

          setBusy(true);

          try {
            await sendDelete({ ids });

            ids.forEach((id) => {
              const row = list.querySelector(`li[data-event-id="${id}"]`);
              if (row) row.remove();
            });

            updateSelection();

            if (list.children.length === 0) {
              list.hidden = true;
              if (emptyState) emptyState.hidden = false;
              if (controls) controls.hidden = true;
            }
          } catch (e) {
            window.alert(e.message);
          } finally {
            setBusy(false);
            updateSelection();
          }
        }

        async function onDeleteBefore() {
          if (!beforeDate.value) return;

          // La web muestra las fechas en hora local, así que el corte también
          // se interpreta en hora local (medianoche del día elegido).
          const [year, month, day] = beforeDate.value.split('-').map(Number);
          const limit = new Date(year, month - 1, day);

          if (Number.isNaN(limit.getTime())) return;

          const readable = limit.toLocaleDateString('es-ES', { dateStyle: 'long' });
          const ok = window.confirm(
            `¿Eliminar todos los eventos anteriores al ${readable} (00:00 hora local)? ` +
              'Esta acción no se puede deshacer.'
          );
          if (!ok) return;

          setBusy(true);

          try {
            await sendDelete({ before: limit.toISOString() });
            // Puede haber afectado a eventos fuera de los cargados: recargamos.
            window.location.reload();
          } catch (e) {
            window.alert(e.message);
            setBusy(false);
            updateSelection();
          }
        }

        list.addEventListener('change', (event) => {
          if (event.target instanceof HTMLInputElement && event.target.classList.contains('event-check')) {
            updateSelection();
          }
        });

        if (selectAll) {
          selectAll.addEventListener('click', () => {
            checks().forEach((check) => {
              check.checked = true;
            });
            updateSelection();
          });
        }

        if (selectNone) {
          selectNone.addEventListener('click', () => {
            checks().forEach((check) => {
              check.checked = false;
            });
            updateSelection();
          });
        }

        beforeDate.addEventListener('change', updateSelection);
        deleteSelected.addEventListener('click', onDeleteSelected);
        deleteBefore.addEventListener('click', onDeleteBefore);

        updateSelection();
      })();
    </script>
  </body>
</html>
