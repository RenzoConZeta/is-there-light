# Ruta al archivo SQLite compartido por web y collector.
DB_PATH=./data/charge.db

# Intervalo (ms) de polling del collector como fallback (macOS/Windows).
COLLECTOR_INTERVAL_MS=2000

# Debounce (ms) al usar fs.watch() (Linux) para evitar eventos duplicados.
POWER_WATCH_DEBOUNCE_MS=100

# Puerto del servidor Astro.
PORT=4321

# Host del servidor Astro.
HOST=localhost

# development | production
NODE_ENV=development
