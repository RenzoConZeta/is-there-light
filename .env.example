# Base remota Turso (libSQL). Si TURSO_DATABASE_URL está definida tiene
# prioridad sobre DB_PATH y web + collector escriben/leen en Turso Cloud.
TURSO_DATABASE_URL=libsql://is-there-electricity-<org>.turso.io
TURSO_AUTH_TOKEN=<tu-token>

# Ruta al archivo SQLite local. Solo se usa como fallback cuando
# TURSO_DATABASE_URL está vacía (desarrollo sin conexión a Turso).
DB_PATH=./data/charge.db

# Intervalo (ms) de polling del collector como fallback (macOS/Windows).
COLLECTOR_INTERVAL_MS=2000

# Debounce (ms) al usar fs.watch() (Linux) para evitar eventos duplicados.
POWER_WATCH_DEBOUNCE_MS=100

# Puerto del servidor Astro. Render inyecta PORT en tiempo de ejecución.
PORT=4321

# Host del servidor Astro. En un host cloud (Render) debe ser 0.0.0.0 para que
# el proxy alcance el servicio; en local, localhost.
HOST=localhost

# development | production
NODE_ENV=development

# Telegram notifications (opcional)
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_CHAT_ID=12345678
# TELEGRAM_ENABLED=true

# Web Push / PWA (opcional). Genera las claves con:
#   npx web-push generate-vapid-keys
# Sin VAPID_PUBLIC_KEY el botón "Activar" de la web falla y el collector no
# envía notificaciones push (queda como no-op con un warning).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@local
